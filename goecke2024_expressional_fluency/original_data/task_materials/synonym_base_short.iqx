<data>
/ columns = [date time subject trialnum blockcode trialcode latency response values.vpcode_hd1]
/ labels = TRUE
/ format = TAB
</data>


*defaults*
<defaults>
/ screencolor = (white)
/ canvasaspectratio = (2560, 1440)
/ fontstyle = ("Calibri", 3.00%, false, false, false, false, 5, 1) 
/ canvasposition = (50%, 50%)
/ canvassize = (100%, 100%)
/ txcolor = (60,60,60)
/ txbgcolor = (white)
</defaults>

<values>
/vpcode_hd1 = 0
</values>

<parameters>
/vpcode_hd2 = 0
</parameters>

<instruct>
/ nextlabel = "Weiter"
/ prevlabel = "Zurück "
/ finishlabel = "Weiter"
/ inputdevice = mouse
/ fontstyle = ("Calibri", 3.00%, false, false, false, false, 5, 1) 
/ windowsize = (95%,95%)
</instruct>

<text FS1_base>
/ numitems = 1
/ items = ("Nennen Sie ein Synonym zu dem Begriff: ~n
 ENTSPANNEN")
/ size = (80%,20%)
</text>

<text FS2_base>
/ numitems = 1
/ items = ("Nennen Sie ein Synonym zu dem Begriff: ~n 
SAUBER")
/ size = (80%,20%)
</text>



<openended FS1_base_txt>
/ stimulusframes = [1=FS1_base]
/ position = (50%, 80%)
/ linelength = 40
/ numlines = 1
/ required = true
/ buttonlabel = "Drücken Sie die Eingabetaste, wenn Sie fertig sind"
</openended>

<openended FS2_base_txt>
/ stimulusframes = [1=FS2_base]
/ position = (50%, 80%)
/ linelength = 40
/ numlines = 1
/ required = true
/ buttonlabel = "Drücken Sie die Eingabetaste, wenn Sie fertig sind"
</openended>

<block instruct>
/ preinstructions = (InstructionsSyn)
</block>

<block FS1_base>
/ trials = [1 = FS1_base_txt; 2=FS1_base_txt; 3=FS1_base_txt; 4=FS1_base_txt; 5=FS1_base_txt; 6=FS1_base_txt; 7=FS1_base_txt; 8=FS1_base_txt; 9=FS1_base_txt; 10=FS1_base_txt; 11 = FS1_base_txt; 12=FS1_base_txt; 13=FS1_base_txt; 
14=FS1_base_txt; 15=FS1_base_txt; 16=FS1_base_txt; 17=FS1_base_txt; 18=FS1_base_txt; 19=FS1_base_txt; 20=FS1_base_txt; 21=FS1_base_txt; 22=FS1_base_txt; 23=FS1_base_txt; 24=FS1_base_txt]
/ timeout = 90000
</block>

<block instruct2>
/ preinstructions = (InstructionsSynBetween)
</block>

<block FS2_base>
/ trials = [1 = FS2_base_txt; 2=FS2_base_txt; 3=FS2_base_txt; 4=FS2_base_txt; 5=FS2_base_txt; 6=FS2_base_txt; 7=FS2_base_txt; 8=FS2_base_txt; 9=FS2_base_txt; 
10=FS2_base_txt; 11 = FS2_base_txt; 12=FS2_base_txt; 13=FS2_base_txt; 14=FS2_base_txt; 15=FS2_base_txt; 16=FS2_base_txt; 17=FS2_base_txt; 18=FS2_base_txt; 19=FS2_base_txt; 20=FS2_base_txt; 21=FS2_base_txt; 22=FS2_base_txt; 23=FS2_base_txt; 24=FS2_base_txt]
/ timeout = 90000
/ postinstructions = (InstructionsEnd)
</block>


<trial start>
/ inputdevice = keyboard
/ validresponse = (28)
</trial>


<expt R>
/ blocks = [1=instruct; 2= FS1_base; 3=instruct2; 4=FS2_base]
/ onexptbegin = [values.vpcode_hd1 = parameters.vpcode_hd2;]
</expt>

<htmlpage InstructionsSyn>
/ file = "InstructionsSyn.htm"
</htmlpage>
<htmlpage InstructionsSynBetween>
/ file = "InstructionsSynBetween.htm"
</htmlpage>
<htmlpage InstructionsEnd>
/ file = "InstructionsEnd.htm"
</htmlpage>

